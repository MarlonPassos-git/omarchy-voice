#!/bin/bash
# omarchy:summary=Choose Realtime or ears/brain/mouth providers
# omarchy:group=voice
# omarchy:examples=omarchy voice setup
set -euo pipefail
# Use the module, not the omarchy-voice route wrapper, to avoid PATH recursion.
SRC="${OMARCHY_VOICE_SRC:-$HOME/.local/share/omarchy-voice/src}"
[[ -d $SRC ]] && export PYTHONPATH="$SRC${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m omarchy_voice setup "$@"
